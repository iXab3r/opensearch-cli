{
  "name": "@eyeauras/opensearch-cli",
  "version": "0.2.0",
  "description": "Explore and manage OpenSearch clusters",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.21.1",
  "bin": {
    "opensearch-cli": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iXab3r/opensearch-cli.git"
  },
  "homepage": "https://github.com/iXab3r/opensearch-cli#readme",
  "bugs": {
    "url": "https://github.com/iXab3r/opensearch-cli/issues"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/src/bin.js",
    "test:package": "node scripts/test-package.mjs",
    "test:registry": "node scripts/test-registry.mjs",
    "proof": "npm run build && node scripts/proof.mjs"
  },
  "dependencies": {
    "@eyeauras/cli-factory": "0.5.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "msw": "3.0.3",
    "typescript": "7.0.2"
  }
}
